# ============================================================
# Admin System - Environment Configuration Template
# Copy this file to .env and fill in the values
#   cp .env.dev .env       (development)
#   cp .env.test .env      (testing)
#   cp .env.prod .env      (production, MUST fill all secrets)
# ============================================================

# --- Docker Compose Profile ---
COMPOSE_PROFILES=dev

# --- Spring Profile: dev / test / prod ---
SPRING_PROFILES_ACTIVE=dev

# --- MySQL ---
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=admin_demo

# --- Spring Datasource ---
SPRING_DATASOURCE_HOST=localhost
SPRING_DATASOURCE_PORT=3306
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=root

# --- Redis ---
SPRING_REDIS_HOST=localhost
SPRING_REDIS_PORT=6379
SPRING_REDIS_PASSWORD=

# --- JWT & Auth ---
JWT_SECRET=change_this_to_a_long_random_secret
TOKEN_EXPIRE_MINUTES=120
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=10

# --- App Startup ---
APP_STARTUP_INIT_ENABLED=true

# --- Connection Pool (prod only) ---
# DB_POOL_MAX=20
# DB_POOL_MIN=5

# --- Port Mapping ---
FRONTEND_PORT=3000
BACKEND_PORT=8080
MYSQL_PORT=3306
REDIS_PORT=6379
